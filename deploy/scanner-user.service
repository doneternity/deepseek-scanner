[Unit]
Description=DeepSeek Key Leak Scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rskll/scanner/deepseek-scanner
ExecStart=/usr/bin/python3 main.py --no-tui
Restart=always
RestartSec=30
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
